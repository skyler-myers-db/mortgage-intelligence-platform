# Local development defaults. Never commit .env or .env.local.
# Copy this file to .env.local and fill in the REDACTED placeholders.
# Pydantic loads .env then .env.local (later wins) via backend/config/settings.py.
#
# Escape hatches (not listed below, not usually set):
#   PYTEST_CURRENT_TEST          -- auto-set by pytest; skips Databricks creds check.
#   MIP_BYPASS_STARTUP_CHECKS=1  -- lint / type-check / schema-only CI phases.

# --- App environment ---
APP_ENV=local
# Optional local-dev only. Leave disabled in shared/customer app deploys so
# /openapi.json, /docs, and /redoc do not expose the full authenticated API
# surface to every workspace user.
MIP_EXPOSE_OPENAPI=0

# --- Catalog + schema (Unity Catalog and Lakebase) ---
# Must match the bundle's provisioned catalog / schemas. Pinned here so a
# stale workspace inheritance does not silently redirect reads.
MIP_DEFAULT_CATALOG=mip
# Optional comma-separated canonical UC owners (users, service-principal
# application IDs, or governance groups). The current deployer username is
# always trusted; group owners additionally require account identity resolution
# plus effective-membership probes executed as every forbidden app-facing M2M
# and any existing target App identity.
MIP_UC_APPROVED_OWNER_PRINCIPALS=
# Always required for deployment identity/role verification. Use a dedicated
# account OAuth identity and never reuse the workspace PAT or any app-facing
# M2M principal. A first install with an approved group owner requires
# account-admin authority because the bundle-created target App cannot be
# delegated in advance. After that install, downscope to Service Principal
# Manager on every normal/operator2/admin/release-probe/verifier/agent-runtime
# principal and the now-existing target App for bounded five-minute probes.
DATABRICKS_ACCOUNT_HOST=https://accounts.cloud.databricks.com
DATABRICKS_ACCOUNT_ID=
DATABRICKS_ACCOUNT_CLIENT_ID=
DATABRICKS_ACCOUNT_CLIENT_SECRET=REDACTED
MIP_DEFAULT_SCHEMA=gold
MIP_LAKEBASE_SCHEMA=mip_app
MIP_LENDER_NAME=Summit Mortgage
MIP_LENDER_NMLS_ID=123456
# Customer values fail closed unless the exact legal-name/NMLS pair has first
# been added to backend/schemas/lender_identity.py in an independently reviewed PR.
# Deployment-owned resource namespace. The defaults preserve the established
# Entrada dev installation; every isolated staging/customer workspace should
# set a unique App, Lakebase instance/catalog, Genie title, and secret scopes.
# MIP_APP_NAME=mip-app
# MIP_LAKEBASE_INSTANCE=mip-app-state
# LAKEBASE_INSTANCE_NAME=mip-app-state
# MIP_LAKEBASE_SYNC_CATALOG=mip_app_state
# MIP_LAKEBASE_SYNC_SCHEMA=mip_sync
# MIP_LAKEBASE_SYNC_TABLES=source_readiness,segment_population,funnel_snapshot_daily
# LAKEBASE_DATABASE=mip_app_state
# MIP_LAKEBASE_DATABASE_NAME=mip_app_state
# MIP_GENIE_SPACE_NAME=Mortgage Lead Intelligence
# MIP_RUNTIME_SECRET_SCOPE=mip-runtime
# MIP_APP_ROLLBACK_SECRET_SCOPE=mip-app-rollback
# The paired instance aliases and paired database aliases must agree when both
# are set. Deployment fails before workspace mutation if either pair drifts.
# Set by scripts/deploy.sh for Databricks Apps snapshots so authenticated
# health can prove the exact deployed source commit.
# MIP_GIT_SHA=<git-sha>
# Optional Lakebase disclosure namespace. Leave unset to derive it from
# MIP_LENDER_NAME (Summit keeps the seeded "summit" namespace).
# MIP_TENANT_ID=summit
# Fail-closed by default: keep mip.first_party.* empty until real lender
# feeds are connected. The deploy wrapper opts the Summit dev demo into
# explicit feed_mode=demo_synthetic rows; customer/prod workspaces should keep
# this at 0 unless an approved demo-only exception is documented.
MIP_ENABLE_DEMO_FIRST_PARTY_FEEDS=0

# --- Databricks SQL warehouse (REQUIRED) ---
# The app runs on live Unity Catalog data in every environment; missing
# values here fail fast at process startup (backend/config/settings.py).
# There is no MIP_MOCK_MODE runtime toggle.
DATABRICKS_HOST=https://<workspace-host>.cloud.databricks.com
DATABRICKS_TOKEN=<pat-or-leave-unset-for-oauth>
DATABRICKS_WAREHOUSE_ID=<sql-warehouse-id>
DATABRICKS_TIMEOUT_S=30

# --- Databricks workspace identity (Apps runtime, OPTIONAL locally) ---
# On Databricks Apps the runtime injects these for service-principal OAuth
# token exchange; DATABRICKS_TOKEN is absent there. Locally you can leave
# them unset and use the PAT above.
# DATABRICKS_CLIENT_ID=<sp-client-id>
# DATABRICKS_CLIENT_SECRET=REDACTED
# Deployment and live verification use five additional, pairwise-distinct
# service principals. None may reuse the normal App user, account-SCIM,
# target-App, or another role's application ID.
# Second non-admin operator used only for per-actor recovery/isolation drills.
# DATABRICKS_OPERATOR2_CLIENT_ID=<operator2-sp-client-id>
# DATABRICKS_OPERATOR2_CLIENT_SECRET=REDACTED
# App administrator used only to mint the short-lived admin bearer.
# DATABRICKS_ADMIN_CLIENT_ID=<admin-sp-client-id>
# DATABRICKS_ADMIN_CLIENT_SECRET=REDACTED
# Admin-capable release probe. It has no persistent App CAN_USE; a fail-closed
# rebase grants it temporary candidate-only access until signed capture.
# DATABRICKS_RELEASE_PROBE_CLIENT_ID=<release-probe-sp-client-id>
# DATABRICKS_RELEASE_PROBE_CLIENT_SECRET=REDACTED
# Exact AI Gateway proof verifier; must have no Databricks App permission.
# DATABRICKS_VERIFIER_CLIENT_ID=<verifier-sp-client-id>
# DATABRICKS_VERIFIER_CLIENT_SECRET=REDACTED
# Runtime owner for the managed Supervisor, Gateway, model, and experiment;
# must have no Databricks App, Lakebase, or SQL warehouse access.
# DATABRICKS_AGENT_RUNTIME_CLIENT_ID=<agent-runtime-sp-client-id>
# DATABRICKS_AGENT_RUNTIME_CLIENT_SECRET=REDACTED

# --- Genie space ---
# Loaded by backend/services/genie_client.py. Deployment writes the governed
# workspace-local id to genie/space_id.txt as a local fallback.
GENIE_SPACE_ID=<genie-space-id>
# Stable server-side HMAC key for Genie actions and generated-campaign proof.
# Prefer the rotation-aware CURRENT/PREVIOUS pair. Every deployed environment,
# including dev and sandbox, must provide an explicit current key. Provision
# the Databricks secret references with
# `python tools/databricks/provision_runtime_secrets.py`; deploy.sh fails closed
# when required runtime secrets are absent. MIP_GENIE_ACTION_SECRET is a legacy
# alias accepted as CURRENT during migration.
MIP_GENIE_ACTION_SECRET=REDACTED
# MIP_GENIE_ACTION_SECRET_CURRENT=REDACTED
# MIP_GENIE_ACTION_SECRET_KID=v1
# MIP_GENIE_ACTION_SECRET_PREVIOUS=REDACTED
# MIP_GENIE_ACTION_SECRET_PREVIOUS_KID=v0
# HMAC key for public display refs derived from Cotality CLIP / Owner Link.
# Required for every deployed environment. Local test processes may use their
# isolated test settings; Databricks dev/sandbox/customer deploys may not fall
# back to a committed or generated masking key.
MIP_COTALITY_ID_MASK_SECRET=REDACTED

# --- DAIS AI capability flags (OPTIONAL, default off) ---
# These switches only expose capability/readiness surfaces when a backing
# Databricks feature is genuinely configured. Leaving them off preserves the
# current governed Genie + Growth Agent path and avoids over-claiming preview
# roadmap items.
MIP_AGENT_ORCHESTRATOR=0
MIP_AI_GATEWAY=0
MIP_LAKEBASE_SYNC=0
MIP_PREVIEW_MIRROR=0
MIP_AGENT_MODEL=databricks-claude-sonnet-4-5
# Gateway-eligible ResponsesAgent endpoint used by product traffic.
# MIP_AGENT_SERVING_ENDPOINT=mip-growth-agent-gateway
# MIP_AGENT_SUPERVISOR_ENDPOINT=<managed-supervisor-endpoint-name>
# MIP_AGENT_SUPERVISOR_ID=<supervisor-agent-id>
# MIP_AGENT_SUPERVISOR_NAME=Mortgage Growth Agent
# Non-secret OAuth application ID that must own the Supervisor and both endpoints.
# MIP_AGENT_RUNTIME_CLIENT_ID=<agent-runtime-service-principal-client-id>
# Optional governed resource families. Deployment derives the selected catalog,
# runtime-owned MLflow path, and a 12-character resource hash; do not put final
# endpoint/model/table names in repository secrets.
# MIP_AI_GATEWAY_AGENT_MODEL_FAMILY=mip.audit.mortgage_growth_supervisor_proxy
# MIP_AI_GATEWAY_AGENT_EXPERIMENT_BASE=mip-agent-runtime-gateway-proxy
# MIP_AI_GATEWAY_TABLE_PREFIX=mip_agent_gateway_growth_agent
# Live-discovered exact values exported by provisioning and injected into the
# App payload. They are shown here only to document the runtime contract.
# MIP_AI_GATEWAY_ENDPOINT=mip-growth-agent-gateway-<resource-hash-12>
# MIP_AI_GATEWAY_INFERENCE_TABLE=mip.audit.mip_agent_gateway_growth_agent_<resource-hash-12>
# MIP_AI_GATEWAY_AGENT_MODEL=mip.audit.mortgage_growth_supervisor_proxy_<resource-hash-12>
# MIP_AI_GATEWAY_AGENT_MODEL_VERSION=<registered-model-version>
# MIP_AI_GATEWAY_AGENT_MODEL_SOURCE=models:/m-<immutable-logged-model-id>
# MIP_AI_GATEWAY_EXPERIMENT_NAME=/Users/<agent-runtime-id>/mip-agent-runtime-gateway-proxy-<resource-hash-12>
# MIP_AI_GATEWAY_EXPERIMENT_ID=<immutable-mlflow-experiment-id>
# MIP_EXPECTED_AGENT_GATEWAY_BINDING_SHA256=<runtime-binding-digest>
# Compact canonical JSON for the complete live Supervisor/Gateway/model/
# experiment/table contract, plus the detached model-authority signature. The
# deploy exporter derives these; never hand-edit them.
# MIP_EXPECTED_AGENT_GATEWAY_RESOURCE_CONTRACT_JSON=<canonical-json>
# MIP_EXPECTED_AGENT_GATEWAY_RESOURCE_SHA256=<full-live-resource-digest>
# MIP_EXPECTED_AGENT_GATEWAY_RESOURCE_SIGNATURE=<base64url-ed25519-signature>
# Per-run UUID acquired atomically under the ACL-protected
# /.mip-deployment-leases directory and renewed by a heartbeat. The workspace
# root avoids /Shared's inherited users-group management permission. Expired
# records fail closed unless the holder presents the exact durable signed
# recovery root. The deploy script discovers that root; do not configure a
# reusable value manually.
# MIP_APP_DEPLOYMENT_LEASE_ID=<deployment-run-uuid>
# Freshness window for the Lakebase proof-ledger row that makes AI Gateway claimable.
# The runtime enforces 93600 seconds (26 hours) as a hard maximum.
MIP_AI_GATEWAY_PROOF_FRESHNESS_S=93600
# Runtime receives only the Ed25519 public verification key. The deploy script
# derives this value; do not copy the verifier private key into the App payload.
# MIP_AI_GATEWAY_PROOF_VERIFY_KEY=<base64url-raw-ed25519-public-key>
# Optional only during a bounded proof-key rotation. Remove immediately after
# every signed App/proof contract has converged to the current key.
# MIP_AI_GATEWAY_PROOF_PREVIOUS_VERIFY_KEY=<temporary-old-public-key-during-rotation>
# MIP_AI_GATEWAY_PROOF_HISTORICAL_VERIFY_KEYS=<oldest-first-comma-separated-public-keys>
# Deployer/verifier automation only. Signs exact inference-row, rollback, and
# cutover-journal evidence. It must never be available to the model runtime.
# MIP_AI_GATEWAY_PROOF_SIGNING_KEY=<base64url-raw-ed25519-private-key>
# Separate model-registration authority. The runtime owner receives this
# private key only for the bounded model registration command; exporters and
# the deployed proxy receive only the derived public key.
# MIP_GATEWAY_MODEL_ATTESTATION_SIGNING_KEY=<base64url-raw-ed25519-private-key>
# MIP_GATEWAY_MODEL_ATTESTATION_VERIFY_KEY=<derived-model-public-key>
# MIP_GATEWAY_MODEL_ATTESTATION_PREVIOUS_VERIFY_KEY=<temporary-old-model-public-key>
# Required before MLflow Agent Evaluation can be shown as provisioned.
# MIP_AGENT_EVAL_EXPERIMENT=/Shared/mip-agent-eval
# MIP_AGENT_EVAL_RUN_ID=<latest-passing-eval-run-id>
# Required before Lakebase synced-table serving can be shown as configured.
# MIP_LAKEBASE_SYNC_CATALOG=mip_app_state
# MIP_LAKEBASE_SYNC_SCHEMA=mip_sync
# MIP_LAKEBASE_SYNC_TABLES=source_readiness,segment_population,funnel_snapshot_daily

# --- Lakebase Postgres (durable audit / approvals / campaigns) ---
# On Databricks Apps the runtime surfaces PGHOST/LAKEBASE_HOST from the
# `database` resource binding; locally, set these to your dev Postgres.
LAKEBASE_HOST=localhost
LAKEBASE_PORT=5432
LAKEBASE_DATABASE=mip_app_state
LAKEBASE_USER=mip
LAKEBASE_PASSWORD=REDACTED
LAKEBASE_SSLMODE=require
# Instance name used by the OAuth-password mint path (backend/services/lakebase.py).
LAKEBASE_INSTANCE_NAME=mip-app-state
# Optional PG* fallbacks honoured if LAKEBASE_* unset:
# PGHOST=  PGPORT=  PGDATABASE=  PGUSER=  PGPASSWORD=

# --- Admin RBAC (controls /api/admin/*) ---
# Exact identities and named emails are the deployed authorization paths.
# Group matching is retained only for local/test compatibility.
# Local/test compatibility only; deployed authorization uses exact identities/emails.
MIP_ADMIN_GROUP_NAME=mip-admin
MIP_ADMIN_EMAILS=
MIP_ADMIN_IDENTITIES=
# Local/test compatibility only; deployed automation uses MIP_APPROVER_IDENTITIES.
MIP_APPROVER_GROUP_NAME=mip-approver
MIP_APPROVER_IDENTITIES=
# Fallback actor when X-Forwarded-Email is absent (local dev / broken header).
MIP_DEFAULT_ACTOR=system@databricks-apps
# Databricks Apps strips inbound X-Forwarded-* headers and injects workspace
# identity, so trust is on by default. Set false outside Databricks Apps unless
# the upstream proxy strips caller-supplied forwarded identity headers.
MIP_TRUST_FORWARDED_HEADERS=true

# --- Scoring thresholds (in-the-money + next-best-offer) ---
# Must stay in sync with tests/fixtures/rate_spread_golden.json and
# tests/fixtures/next_best_offer_golden.json. Override for admin tuning.
MIP_MARKET_RATE=0.04875
MIP_MIN_SPREAD_BPS=75
MIP_MIN_EQUITY_PCT=15
MIP_HELOC_EQUITY_MIN_PCT=35
MIP_CASHOUT_EQUITY_MIN_PCT=25
MIP_RETENTION_MIN_SPREAD_BPS=50

# --- Cache TTLs (seconds; Slice-6 resilience) ---
# Short-window memoization on stale-tolerant gold projections. Fresh
# Lakebase workflow state still hydrates after cached lead/dossier reads;
# audit and outreach writes never consult the cache. The default covers
# a sustained warm-load run after pre-measurement cache warmup.
# Set MIP_CACHE_TTL_S=0 in tests to disable.
MIP_CACHE_TTL_S=300
MIP_LIVE_CAPABILITY_PROBE_TTL_S=60
MIP_SALES_STATE_CACHE_TTL_S=600
MIP_PORTFOLIO_PREVIEW_TTL_S=120

# --- Browser RUM telemetry (optional) ---
# Default is opt-in for customer compliance review. When enabled, the backend
# accepts only sanitized route patterns and aggregate performance metrics; no
# query strings, borrower IDs, UUIDs, email addresses, or free-form text.
MIP_RUM_ENABLED=0

# --- Load protection (optional tuning) ---
# Process-local token buckets and dependency semaphores. Defaults match the
# sustained warm-load baseline; tune only after running tools/load_test.
MIP_BACKPRESSURE_ENABLED=1
MIP_RATE_LIMIT_DEFAULT_PER_MINUTE=600
MIP_RATE_LIMIT_EXPENSIVE_PER_MINUTE=360
MIP_RATE_LIMIT_MUTATION_PER_MINUTE=120
MIP_RATE_LIMIT_GENIE_PER_MINUTE=30
MIP_RATE_LIMIT_TELEMETRY_PER_MINUTE=1200
MIP_WAREHOUSE_CONCURRENCY_LIMIT=24
MIP_LAKEBASE_CONCURRENCY_LIMIT=16
MIP_GENIE_CONCURRENCY_LIMIT=6
# Genie routing posture. true (product default) sends every guardrail-passing
# question to LIVE Genie first; the reviewed deterministic canonical answers are
# consulted only as an honest degraded-mode fallback (breaker open / dependency
# down) and disclose that live Genie was unavailable. false is the legacy/
# emergency booth posture: canonical interceptors answer BEFORE live Genie.
MIP_GENIE_LIVE_FIRST=true

# --- Lakebase pool (optional tuning) ---
# Max size intentionally matches MIP_LAKEBASE_CONCURRENCY_LIMIT so pool checkout
# does not become the bottleneck before the app-side semaphore.
MIP_LAKEBASE_POOL_MAX_SIZE=16
MIP_LAKEBASE_POOL_TIMEOUT_S=2.0
MIP_LAKEBASE_POOL_MAX_LIFETIME_S=3000.0
MIP_LAKEBASE_CONNECT_TIMEOUT_S=2
MIP_LAKEBASE_TRANSPORT_TIMEOUT_S=2
MIP_LAKEBASE_HEALTH_STATEMENT_TIMEOUT_S=2.0
MIP_HEALTH_COLD_WAIT_BUDGET_S=3.0

# --- OpenTelemetry OTLP log export (OPTIONAL, Slice-13) ---
# The governed deploy requires all three settings together. Store the actual
# comma-separated collector headers only in the referenced Databricks Secret;
# never export MIP_OTEL_HEADERS or place its value in this file.
# MIP_OTEL_ENDPOINT=https://otel.example.com:4318/v1/logs
# MIP_OTEL_HEADERS_SECRET_SCOPE=customer-observability
# MIP_OTEL_HEADERS_SECRET_KEY=otlp-headers
# MIP_OTEL_HEADERS=VALUE_FROM_DATABRICKS_SECRET_ONLY_NEVER_PLAINTEXT

# --- FRED API key (OPTIONAL) ---
# The FRED ingest job (jobs/fred_rates_ingest.py) currently hits the public
# unauthenticated fredgraph.csv endpoint, so this key is NOT required today.
# It is declared as a bundle variable (databricks.yml: fred_api_key) so any
# future switch to api.stlouisfed.org REST endpoints is a one-line
# .env.local edit, never a click-ops step. Leave blank unless you have a
# specific reason to authenticate (higher rate limits, private series).
FRED_API_KEY=
# Optional FRED edge override. Default sends no custom user-agent because
# FRED/Akamai has timed out on bespoke app user-agents.
# FRED_USER_AGENT=

# --- Direct os.environ reads / deploy-only knobs (not Settings fields) ---
# These are real runtime or deploy-script inputs, but they are read directly by
# a narrow integration seam instead of backend/config/settings.py.
# LAKEBASE_INSTANCE_NAME=mip-app-state
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=mip_app_state
# PGUSER=mip
# PGPASSWORD=REDACTED
# MIP_COTALITY_ID_MASK_SECRET=REDACTED
# MIP_ENABLE_DEMO_FIRST_PARTY_FEEDS=0
# MIP_LIFECYCLE_SYNC_JOB_ID=<job-id>
# MIP_API_PREFIX=/api/v1
# MIP_LOAD_TEST_WRITE=0
# MIP_BEARER_TOKEN=<bearer-for-load-test>

# --- Claude Code MCP (local tooling only; never read by the app) ---
GITHUB_PERSONAL_ACCESS_TOKEN=<optional>
MAX_MCP_OUTPUT_TOKENS=50000
MCP_TIMEOUT=15000

# Optional walkthrough-only refresh-ahead cadence (seconds) for the default
# /api/leads page cache — the slowest hot-path query. A positive value keeps
# re-querying the SQL warehouse and can prevent auto-stop; deployed Apps set
# this to 0 by default for cost control. If deliberately enabling before a
# staffed demo block, keep it BELOW MIP_CACHE_TTL_S so the entry refreshes
# before expiry. 0 disables the re-warm loop.
# MIP_LEADS_WARM_INTERVAL_S=240

# Optional email escape hatch for /outreach/approve|reject. Deployed automation
# uses MIP_APPROVER_IDENTITIES, matched against the resolved forwarded identity;
# admins also pass. Empty allowlists never admit every authenticated user.
# MIP_APPROVER_EMAILS=

# PII salt (re-audit 2026-06-11 doc note): the silver-plane salt is NOT an
# env var — it lives in Databricks secret scope `mip`, key `pii-salt-v1`,
# provisioned automatically by scripts/deploy.sh step 4d (create-if-missing,
# never rotated). Do not add a salt value to any .env file.

# --- Salesforce activation delivery (OPTIONAL, Feature B) ---
# Unconfigured = activation rows stay STAGED only (honest dry_run); the app
# never claims a delivery without a real Salesforce External-ID upsert. Production should
# migrate to the JWT bearer flow (username-password is the minimal real flow).
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_API_VERSION=v60.0
SALESFORCE_SOBJECT=Task
# Required for real delivery. Configure a unique Salesforce External ID text
# field (for example MIP_Activation_Id__c) on SALESFORCE_SOBJECT.
SALESFORCE_EXTERNAL_ID_FIELD=
SALESFORCE_TIMEOUT_S=10.0
