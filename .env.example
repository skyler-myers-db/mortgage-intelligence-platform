# Local development defaults. Never commit .env or .env.local.
# Copy this file to .env.local and fill in the REDACTED placeholders.
# Pydantic loads .env then .env.local (later wins) via backend/config/settings.py.
#
# Escape hatches (not listed below, not usually set):
#   PYTEST_CURRENT_TEST          -- auto-set by pytest; skips Databricks creds check.
#   MIP_BYPASS_STARTUP_CHECKS=1  -- lint / type-check / schema-only CI phases.

# --- App environment ---
APP_ENV=local
# Optional local-dev only. Leave disabled in shared/customer app deploys so
# /openapi.json, /docs, and /redoc do not expose the full authenticated API
# surface to every workspace user.
MIP_EXPOSE_OPENAPI=0

# --- Catalog + schema (Unity Catalog and Lakebase) ---
# Must match the bundle's provisioned catalog / schemas. Pinned here so a
# stale workspace inheritance does not silently redirect reads.
MIP_DEFAULT_CATALOG=mip
MIP_DEFAULT_SCHEMA=gold
MIP_LAKEBASE_SCHEMA=mip_app
MIP_LENDER_NAME=Summit Mortgage
# Set by scripts/deploy.sh for Databricks Apps snapshots so authenticated
# health can prove the exact deployed source commit.
# MIP_GIT_SHA=<git-sha>
# Optional Lakebase disclosure namespace. Leave unset to derive it from
# MIP_LENDER_NAME (Summit keeps the seeded "summit" namespace).
# MIP_TENANT_ID=summit
# Fail-closed by default: keep mip.first_party.* empty until real lender
# feeds are connected. The deploy wrapper opts the Summit dev demo into
# explicit feed_mode=demo_synthetic rows; customer/prod workspaces should keep
# this at 0 unless an approved demo-only exception is documented.
MIP_ENABLE_DEMO_FIRST_PARTY_FEEDS=0

# --- Databricks SQL warehouse (REQUIRED) ---
# The app runs on live Unity Catalog data in every environment; missing
# values here fail fast at process startup (backend/config/settings.py).
# There is no MIP_MOCK_MODE runtime toggle.
DATABRICKS_HOST=https://<workspace-host>.cloud.databricks.com
DATABRICKS_TOKEN=<pat-or-leave-unset-for-oauth>
DATABRICKS_WAREHOUSE_ID=<sql-warehouse-id>
DATABRICKS_TIMEOUT_S=30

# --- Databricks workspace identity (Apps runtime, OPTIONAL locally) ---
# On Databricks Apps the runtime injects these for service-principal OAuth
# token exchange; DATABRICKS_TOKEN is absent there. Locally you can leave
# them unset and use the PAT above.
# DATABRICKS_CLIENT_ID=<sp-client-id>
# DATABRICKS_CLIENT_SECRET=REDACTED

# --- Genie space ---
# Loaded by backend/services/genie_client.py. If unset, falls back to the
# repo-committed id at genie/space_id.txt so a fresh checkout still works.
GENIE_SPACE_ID=<genie-space-id>
# Optional stable server-side HMAC key for Genie action confirmation tokens.
# Prefer the rotation-aware CURRENT/PREVIOUS pair for shared/customer deploys.
# MIP_GENIE_ACTION_SECRET remains a legacy alias for CURRENT. If no stable key
# is set, the app uses a process-local key and outstanding answer actions are
# invalid after an app restart.
MIP_GENIE_ACTION_SECRET=REDACTED
# MIP_GENIE_ACTION_SECRET_CURRENT=REDACTED
# MIP_GENIE_ACTION_SECRET_KID=v1
# MIP_GENIE_ACTION_SECRET_PREVIOUS=REDACTED
# MIP_GENIE_ACTION_SECRET_PREVIOUS_KID=v0
# HMAC key for public display refs derived from Cotality CLIP / Owner Link.
# Required for customer/non-sandbox runtime deploys. The dev sandbox may omit
# this and use the stable source namespace for repeatable synthetic demos.
MIP_COTALITY_ID_MASK_SECRET=REDACTED

# --- DAIS AI capability flags (OPTIONAL, default off) ---
# These switches only expose capability/readiness surfaces when a backing
# Databricks feature is genuinely configured. Leaving them off preserves the
# current governed Genie + Growth Agent path and avoids over-claiming preview
# roadmap items.
MIP_AGENT_ORCHESTRATOR=0
MIP_AI_GATEWAY=0
MIP_LAKEBASE_SYNC=0
MIP_PREVIEW_MIRROR=0
MIP_AGENT_MODEL=databricks-claude-sonnet-4-5
# MIP_AGENT_SERVING_ENDPOINT=<serving-endpoint-name>
# MIP_AGENT_SUPERVISOR_ID=<supervisor-agent-id>
# MIP_AGENT_SUPERVISOR_NAME=Mortgage Growth Agent
# Required before MIP_AI_GATEWAY can be shown as configured.
# MIP_AI_GATEWAY_ENDPOINT=<serving-endpoint-name>
# MIP_AI_GATEWAY_INFERENCE_TABLE=<catalog.schema.inference_table>
# Freshness window for the Lakebase proof-ledger row that makes AI Gateway claimable.
MIP_AI_GATEWAY_PROOF_FRESHNESS_S=93600
# Required before MLflow Agent Evaluation can be shown as provisioned.
# MIP_AGENT_EVAL_EXPERIMENT=/Shared/mip-agent-eval
# MIP_AGENT_EVAL_RUN_ID=<latest-passing-eval-run-id>
# Required before Lakebase synced-table serving can be shown as configured.
# MIP_LAKEBASE_SYNC_CATALOG=mip_app_state
# MIP_LAKEBASE_SYNC_SCHEMA=mip_sync
# MIP_LAKEBASE_SYNC_TABLES=source_readiness,segment_population,funnel_snapshot_daily

# --- Lakebase Postgres (durable audit / approvals / campaigns) ---
# On Databricks Apps the runtime surfaces PGHOST/LAKEBASE_HOST from the
# `database` resource binding; locally, set these to your dev Postgres.
LAKEBASE_HOST=localhost
LAKEBASE_PORT=5432
LAKEBASE_DATABASE=mip_app_state
LAKEBASE_USER=mip
LAKEBASE_PASSWORD=REDACTED
LAKEBASE_SSLMODE=require
# Instance name used by the OAuth-password mint path (backend/services/lakebase.py).
LAKEBASE_INSTANCE_NAME=mip-app-state
# Optional PG* fallbacks honoured if LAKEBASE_* unset:
# PGHOST=  PGPORT=  PGDATABASE=  PGUSER=  PGPASSWORD=

# --- Admin RBAC (controls /api/admin/*) ---
# Group membership is the preferred admin path. The email allowlist is an
# explicit day-0 escape hatch before workspace groups are provisioned; leave it
# blank unless a named customer admin should be admitted by email.
MIP_ADMIN_GROUP_NAME=mip-admin
MIP_ADMIN_EMAILS=
# Fallback actor when X-Forwarded-Email is absent (local dev / broken header).
MIP_DEFAULT_ACTOR=system@databricks-apps
# Databricks Apps strips inbound X-Forwarded-* headers and injects workspace
# identity, so trust is on by default. Set false outside Databricks Apps unless
# the upstream proxy strips caller-supplied forwarded identity headers.
MIP_TRUST_FORWARDED_HEADERS=true

# --- Scoring thresholds (in-the-money + next-best-offer) ---
# Must stay in sync with tests/fixtures/rate_spread_golden.json and
# tests/fixtures/next_best_offer_golden.json. Override for admin tuning.
MIP_MARKET_RATE=0.04875
MIP_MIN_SPREAD_BPS=75
MIP_MIN_EQUITY_PCT=15
MIP_HELOC_EQUITY_MIN_PCT=35
MIP_CASHOUT_EQUITY_MIN_PCT=25
MIP_RETENTION_MIN_SPREAD_BPS=50

# --- Cache TTLs (seconds; Slice-6 resilience) ---
# Short-window memoization on stale-tolerant gold projections. Fresh
# Lakebase workflow state still hydrates after cached lead/dossier reads;
# audit and outreach writes never consult the cache. The default covers
# a sustained warm-load run after pre-measurement cache warmup.
# Set MIP_CACHE_TTL_S=0 in tests to disable.
MIP_CACHE_TTL_S=300
MIP_LIVE_CAPABILITY_PROBE_TTL_S=60
MIP_SALES_STATE_CACHE_TTL_S=600
MIP_PORTFOLIO_PREVIEW_TTL_S=120

# --- Browser RUM telemetry (optional) ---
# Default is opt-in for customer compliance review. When enabled, the backend
# accepts only sanitized route patterns and aggregate performance metrics; no
# query strings, borrower IDs, UUIDs, email addresses, or free-form text.
MIP_RUM_ENABLED=0

# --- Load protection (optional tuning) ---
# Process-local token buckets and dependency semaphores. Defaults match the
# sustained warm-load baseline; tune only after running tools/load_test.
MIP_BACKPRESSURE_ENABLED=1
MIP_RATE_LIMIT_DEFAULT_PER_MINUTE=600
MIP_RATE_LIMIT_EXPENSIVE_PER_MINUTE=360
MIP_RATE_LIMIT_MUTATION_PER_MINUTE=120
MIP_RATE_LIMIT_GENIE_PER_MINUTE=30
MIP_RATE_LIMIT_TELEMETRY_PER_MINUTE=1200
MIP_WAREHOUSE_CONCURRENCY_LIMIT=24
MIP_LAKEBASE_CONCURRENCY_LIMIT=16
MIP_GENIE_CONCURRENCY_LIMIT=6
# Genie routing posture. true (product default) sends every guardrail-passing
# question to LIVE Genie first; the reviewed deterministic canonical answers are
# consulted only as an honest degraded-mode fallback (breaker open / dependency
# down) and disclose that live Genie was unavailable. false is the legacy/
# emergency booth posture: canonical interceptors answer BEFORE live Genie.
MIP_GENIE_LIVE_FIRST=true

# --- Lakebase pool (optional tuning) ---
# Max size intentionally matches MIP_LAKEBASE_CONCURRENCY_LIMIT so pool checkout
# does not become the bottleneck before the app-side semaphore.
MIP_LAKEBASE_POOL_MAX_SIZE=16
MIP_LAKEBASE_POOL_TIMEOUT_S=2.0
MIP_LAKEBASE_POOL_MAX_LIFETIME_S=3000.0

# --- OpenTelemetry OTLP log export (OPTIONAL, Slice-13) ---
# When MIP_OTEL_ENDPOINT is set at boot, JSON logs are additionally
# shipped via the OTLP logs exporter. Unset = stdout-only (default).
# Headers is "k=v,k2=v2" -- typically the Splunk HEC / Datadog API token.
# MIP_OTEL_ENDPOINT=https://otel.example.com:4318
# MIP_OTEL_HEADERS=REDACTED

# --- FRED API key (OPTIONAL) ---
# The FRED ingest job (jobs/fred_rates_ingest.py) currently hits the public
# unauthenticated fredgraph.csv endpoint, so this key is NOT required today.
# It is declared as a bundle variable (databricks.yml: fred_api_key) so any
# future switch to api.stlouisfed.org REST endpoints is a one-line
# .env.local edit, never a click-ops step. Leave blank unless you have a
# specific reason to authenticate (higher rate limits, private series).
FRED_API_KEY=
# Optional FRED edge override. Default sends no custom user-agent because
# FRED/Akamai has timed out on bespoke app user-agents.
# FRED_USER_AGENT=

# --- Direct os.environ reads / deploy-only knobs (not Settings fields) ---
# These are real runtime or deploy-script inputs, but they are read directly by
# a narrow integration seam instead of backend/config/settings.py.
# LAKEBASE_INSTANCE_NAME=mip-app-state
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=mip_app_state
# PGUSER=mip
# PGPASSWORD=REDACTED
# MIP_COTALITY_ID_MASK_SECRET=REDACTED
# MIP_ENABLE_DEMO_FIRST_PARTY_FEEDS=0
# MIP_LIFECYCLE_SYNC_JOB_ID=<job-id>
# MIP_API_PREFIX=/api/v1
# MIP_LOAD_TEST_WRITE=0
# MIP_BEARER_TOKEN=<bearer-for-load-test>

# --- Claude Code MCP (local tooling only; never read by the app) ---
GITHUB_PERSONAL_ACCESS_TOKEN=<optional>
MAX_MCP_OUTPUT_TOKENS=50000
MCP_TIMEOUT=15000

# Optional walkthrough-only refresh-ahead cadence (seconds) for the default
# /api/leads page cache — the slowest hot-path query. A positive value keeps
# re-querying the SQL warehouse and can prevent auto-stop; deployed Apps set
# this to 0 by default for cost control. If deliberately enabling before a
# staffed demo block, keep it BELOW MIP_CACHE_TTL_S so the entry refreshes
# before expiry. 0 disables the re-warm loop.
# MIP_LEADS_WARM_INTERVAL_S=240

# 2026-06-11 audit P2-5: OPTIONAL approver allowlist for /outreach/approve|reject.
# Empty (default) = any authenticated workspace user may decide, with full audit
# attribution — the documented Module 0 demo posture. Set comma-separated emails
# to enforce; admins (group or MIP_ADMIN_EMAILS) always pass so the deploying
# operator cannot lock themselves out.
# MIP_APPROVER_EMAILS=

# PII salt (re-audit 2026-06-11 doc note): the silver-plane salt is NOT an
# env var — it lives in Databricks secret scope `mip`, key `pii-salt-v1`,
# provisioned automatically by scripts/deploy.sh step 4d (create-if-missing,
# never rotated). Do not add a salt value to any .env file.

# --- Salesforce activation delivery (OPTIONAL, Feature B) ---
# Unconfigured = activation rows stay STAGED only (honest dry_run); the app
# never claims a delivery without a real Salesforce 201. Production should
# migrate to the JWT bearer flow (username-password is the minimal real flow).
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_API_VERSION=v60.0
SALESFORCE_SOBJECT=Task
SALESFORCE_TIMEOUT_S=10.0
