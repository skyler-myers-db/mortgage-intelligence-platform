# Local development defaults. Never commit .env or .env.local.
APP_ENV=local
MIP_DEMO_LENDER=Summit Mortgage
MIP_DEFAULT_CATALOG=mip
MIP_DEFAULT_SCHEMA=gold
MIP_LAKEBASE_SCHEMA=mip_app

# --- Databricks SQL warehouse (REQUIRED) ---
# Slice-4 invariant: the app runs on live Unity Catalog data in every
# environment; missing values here fail fast at process startup. There is
# no MIP_MOCK_MODE runtime toggle. Copy to .env.local and fill in.
DATABRICKS_HOST=https://<workspace-host>
DATABRICKS_TOKEN=<set-in-secret-scope-or-local-PAT>
DATABRICKS_WAREHOUSE_ID=<sql-warehouse-id>
DATABRICKS_TIMEOUT_S=30

GENIE_SPACE_ID=<genie-space-id>

# Optional local Lakebase/Postgres development.
LAKEBASE_HOST=localhost
LAKEBASE_PORT=5432
LAKEBASE_DATABASE=mip
LAKEBASE_USER=mip
LAKEBASE_PASSWORD=mip

# Claude Code MCP configs may reference these; keep values local only.
GITHUB_PERSONAL_ACCESS_TOKEN=<optional>
MAX_MCP_OUTPUT_TOKENS=50000
MCP_TIMEOUT=15000
