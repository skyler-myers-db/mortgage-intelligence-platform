{
  "datasets": [
    {
      "name": "ds_funnel_totals",
      "displayName": "Lead funnel totals",
      "queryLines": [
        "SELECT addressable_borrowers,",
        "       in_the_money_borrowers,",
        "       high_opportunity_borrowers,",
        "       offer_recommended_borrowers,",
        "       approved_borrowers,",
        "       actioned_borrowers",
        "FROM mip.gold.funnel_snapshot_daily",
        "WHERE state = '_ALL' AND segment_code = '_ALL'",
        "ORDER BY snapshot_date DESC, snapshot_at DESC",
        "LIMIT 1"
      ]
    },
    {
      "name": "ds_funnel_stages",
      "displayName": "Lead funnel stages",
      "queryLines": [
        "WITH latest AS (",
        "  SELECT addressable_borrowers, in_the_money_borrowers, high_opportunity_borrowers,",
        "         offer_recommended_borrowers, approved_borrowers, actioned_borrowers",
        "  FROM mip.gold.funnel_snapshot_daily",
        "  WHERE state = '_ALL' AND segment_code = '_ALL'",
        "  ORDER BY snapshot_date DESC, snapshot_at DESC",
        "  LIMIT 1",
        ")",
        "SELECT stage, stage_order, borrower_count FROM (",
        "  SELECT 'Addressable'           AS stage, 1 AS stage_order, addressable_borrowers AS borrower_count FROM latest",
        "  UNION ALL",
        "  SELECT 'In the Money',              2, in_the_money_borrowers                         FROM latest",
        "  UNION ALL",
        "  SELECT 'High Opportunity (>= 75)',  3, high_opportunity_borrowers                    FROM latest",
        "  UNION ALL",
        "  SELECT 'Offer Recommended',         4, offer_recommended_borrowers                   FROM latest",
        "  UNION ALL",
        "  SELECT 'Approved',                  5, approved_borrowers                            FROM latest",
        "  UNION ALL",
        "  SELECT 'Actioned',                  6, actioned_borrowers                            FROM latest",
        ") ORDER BY stage_order"
      ]
    },
    {
      "name": "ds_score_distribution",
      "displayName": "Opportunity score distribution",
      "queryLines": [
        "SELECT",
        "  CAST(FLOOR(opportunity_score / 5) * 5 AS INT) AS score_bucket,",
        "  COUNT(*)                                      AS borrower_count",
        "FROM mip.gold.borrower_360",
        "GROUP BY CAST(FLOOR(opportunity_score / 5) * 5 AS INT)",
        "ORDER BY score_bucket"
      ]
    },
    {
      "name": "ds_state_opportunity",
      "displayName": "Mean opportunity score by state",
      "queryLines": [
        "SELECT",
        "  state                                         AS state,",
        "  COUNT(DISTINCT clip)                          AS borrower_count,",
        "  CAST(ROUND(AVG(opportunity_score)) AS INT)    AS mean_opportunity_score,",
        "  SUM(CASE WHEN in_the_money THEN 1 ELSE 0 END) AS in_the_money_borrowers",
        "FROM mip.semantics.borrower_opportunity_metric_view",
        "GROUP BY state",
        "ORDER BY mean_opportunity_score DESC"
      ]
    },
    {
      "name": "ds_state_avm_value",
      "displayName": "Total AVM value by state",
      "queryLines": [
        "SELECT",
        "  state                               AS state,",
        "  SUM(avm_value)                      AS total_avm_value_usd,",
        "  SUM(current_lien_balance)           AS total_lien_balance_usd,",
        "  SUM(equity_estimate)                AS total_equity_usd",
        "FROM mip.gold.borrower_360",
        "GROUP BY state",
        "ORDER BY total_avm_value_usd DESC"
      ]
    },
    {
      "name": "ds_top_zips_itm",
      "displayName": "Top 20 ZIPs by in-the-money borrowers",
      "queryLines": [
        "SELECT",
        "  state                                                     AS state,",
        "  zip                                                       AS zip,",
        "  city                                                      AS city,",
        "  COUNT(*)                                                  AS borrower_count,",
        "  SUM(CASE WHEN in_the_money THEN 1 ELSE 0 END)              AS in_the_money_borrowers,",
        "  CAST(ROUND(AVG(opportunity_score)) AS INT)                AS mean_opportunity_score,",
        "  CAST(ROUND(AVG(rate_spread_bps))  AS INT)                 AS mean_rate_spread_bps",
        "FROM mip.gold.borrower_360",
        "WHERE zip IS NOT NULL",
        "GROUP BY state, zip, city",
        "HAVING SUM(CASE WHEN in_the_money THEN 1 ELSE 0 END) > 0",
        "ORDER BY in_the_money_borrowers DESC",
        "LIMIT 20"
      ]
    },
    {
      "name": "ds_rate_spread_hist",
      "displayName": "Rate spread distribution (bps)",
      "queryLines": [
        "SELECT",
        "  CAST(FLOOR(rate_spread_bps / 25) * 25 AS INT) AS spread_bucket_bps,",
        "  COUNT(*)                                      AS borrower_count",
        "FROM mip.gold.borrower_360",
        "WHERE rate_spread_bps BETWEEN -100 AND 400",
        "GROUP BY CAST(FLOOR(rate_spread_bps / 25) * 25 AS INT)",
        "ORDER BY spread_bucket_bps"
      ]
    },
    {
      "name": "ds_equity_vs_spread",
      "displayName": "Equity percent vs rate spread by segment",
      "queryLines": [
        "SELECT",
        "  segment                AS segment,",
        "  state                  AS state,",
        "  equity_pct             AS equity_pct,",
        "  rate_spread_bps        AS rate_spread_bps,",
        "  opportunity_score      AS opportunity_score",
        "FROM mip.semantics.borrower_opportunity_metric_view",
        "WHERE rate_spread_bps BETWEEN -100 AND 400",
        "  AND equity_pct       BETWEEN    0 AND 100",
        "LIMIT 5000"
      ]
    },
    {
      "name": "ds_top_borrowers",
      "displayName": "Top 10 borrowers by opportunity score",
      "queryLines": [
        "SELECT",
        "  borrower_id             AS borrower_id,",
        "  display_name            AS display_name,",
        "  state                   AS state,",
        "  city                    AS city,",
        "  opportunity_score       AS opportunity_score,",
        "  rate_spread_bps         AS rate_spread_bps,",
        "  equity_pct              AS equity_pct,",
        "  recommended_offer       AS recommended_offer,",
        "  rank_overall            AS rank_overall",
        "FROM mip.gold.lead_population",
        "ORDER BY opportunity_score DESC, rank_overall ASC",
        "LIMIT 10"
      ]
    }
  ],
  "pages": [
    {
