{
  "datasets": [
    {
      "name": "ds_funnel_totals",
      "displayName": "Lead funnel totals",
      "queryLines": [
        "SELECT addressable_borrowers,\n       in_the_money_borrowers,\n       high_opportunity_borrowers,\n       offer_recommended_borrowers,\n       approved_borrowers,\n       actioned_borrowers\nFROM mip.gold.funnel_snapshot_daily\nWHERE state = '_ALL' AND segment_code = '_ALL'\nORDER BY snapshot_date DESC, snapshot_at DESC\nLIMIT 1"
      ]
    },
    {
      "name": "ds_funnel_stages",
      "displayName": "Lead funnel stages",
      "queryLines": [
        "WITH latest AS (\n  SELECT addressable_borrowers, in_the_money_borrowers, high_opportunity_borrowers,\n         offer_recommended_borrowers, approved_borrowers, actioned_borrowers\n  FROM mip.gold.funnel_snapshot_daily\n  WHERE state = '_ALL' AND segment_code = '_ALL'\n  ORDER BY snapshot_date DESC, snapshot_at DESC\n  LIMIT 1\n)\nSELECT stage, stage_order, borrower_count FROM (\n  SELECT 'Addressable'           AS stage, 1 AS stage_order, addressable_borrowers AS borrower_count FROM latest\n  UNION ALL\n  SELECT 'In the Money',              2, in_the_money_borrowers                         FROM latest\n  UNION ALL\n  SELECT 'High Opportunity (>= 75)',  3, high_opportunity_borrowers                    FROM latest\n  UNION ALL\n  SELECT 'Offer Recommended',         4, offer_recommended_borrowers                   FROM latest\n  UNION ALL\n  SELECT 'Approved',                  5, approved_borrowers                            FROM latest\n  UNION ALL\n  SELECT 'Actioned',                  6, actioned_borrowers                            FROM latest\n) ORDER BY stage_order"
      ]
    },
    {
      "name": "ds_score_distribution",
      "displayName": "Opportunity score distribution",
      "queryLines": [
        "SELECT\n  CAST(FLOOR(opportunity_score / 5) * 5 AS INT) AS score_bucket,\n  COUNT(*)                                      AS borrower_count\nFROM mip.gold.borrower_360\nGROUP BY CAST(FLOOR(opportunity_score / 5) * 5 AS INT)\nORDER BY score_bucket"
      ]
    },
    {
      "name": "ds_state_opportunity",
      "displayName": "Mean opportunity score by state",
      "queryLines": [
        "SELECT\n  state                                         AS state,\n  COUNT(DISTINCT clip)                          AS borrower_count,\n  CAST(ROUND(AVG(opportunity_score)) AS INT)    AS mean_opportunity_score,\n  SUM(CASE WHEN in_the_money THEN 1 ELSE 0 END) AS in_the_money_borrowers\nFROM mip.semantics.borrower_opportunity_metric_view\nGROUP BY state\nORDER BY mean_opportunity_score DESC"
      ]
    },
    {
      "name": "ds_state_avm_value",
      "displayName": "Total AVM value by state",
      "queryLines": [
        "SELECT\n  state                               AS state,\n  SUM(avm_value)                      AS total_avm_value_usd,\n  SUM(current_lien_balance)           AS total_lien_balance_usd,\n  SUM(equity_estimate)                AS total_equity_usd\nFROM mip.gold.borrower_360\nGROUP BY state\nORDER BY total_avm_value_usd DESC"
      ]
    },
    {
      "name": "ds_top_zips_itm",
      "displayName": "Top 20 ZIPs by in-the-money borrowers",
      "queryLines": [
        "SELECT\n  state                                                     AS state,\n  zip                                                       AS zip,\n  city                                                      AS city,\n  COUNT(*)                                                  AS borrower_count,\n  SUM(CASE WHEN in_the_money THEN 1 ELSE 0 END)              AS in_the_money_borrowers,\n  CAST(ROUND(AVG(opportunity_score)) AS INT)                AS mean_opportunity_score,\n  CAST(ROUND(AVG(rate_spread_bps))  AS INT)                 AS mean_rate_spread_bps\nFROM mip.gold.borrower_360\nWHERE zip IS NOT NULL\nGROUP BY state, zip, city\nHAVING SUM(CASE WHEN in_the_money THEN 1 ELSE 0 END) > 0\nORDER BY in_the_money_borrowers DESC\nLIMIT 20"
      ]
    },
    {
      "name": "ds_rate_spread_hist",
      "displayName": "Rate spread distribution (bps)",
      "queryLines": [
        "SELECT\n  CAST(FLOOR(rate_spread_bps / 25) * 25 AS INT) AS spread_bucket_bps,\n  COUNT(*)                                      AS borrower_count\nFROM mip.gold.borrower_360\nWHERE rate_spread_bps BETWEEN -100 AND 400\nGROUP BY CAST(FLOOR(rate_spread_bps / 25) * 25 AS INT)\nORDER BY spread_bucket_bps"
      ]
    },
    {
      "name": "ds_equity_vs_spread",
      "displayName": "Equity percent vs rate spread by segment",
      "queryLines": [
        "SELECT\n  CASE primary_segment\n    WHEN 'equity' THEN 'Home Equity Candidate'\n    WHEN 'itm' THEN 'In the Money'\n    WHEN 'investor' THEN 'Investor / Multi-Property'\n    WHEN 'listed' THEN 'Listed for Sale'\n    WHEN 'permit' THEN 'Permit Activity'\n    WHEN 'retention' THEN 'Retention Risk'\n    ELSE 'None / Unsegmented'\n  END                    AS segment,\n  state                  AS state,\n  equity_pct             AS equity_pct,\n  rate_spread_bps        AS rate_spread_bps,\n  opportunity_score      AS opportunity_score\nFROM mip.semantics.borrower_opportunity_metric_view\nWHERE rate_spread_bps BETWEEN -100 AND 400\n  AND equity_pct       BETWEEN    0 AND 100\nLIMIT 5000"
      ]
    },
    {
      "name": "ds_top_borrowers",
      "displayName": "Top 10 borrowers by opportunity score",
      "queryLines": [
        "SELECT\n  borrower_id             AS borrower_id,\n  display_name            AS display_name,\n  state                   AS state,\n  city                    AS city,\n  opportunity_score       AS opportunity_score,\n  rate_spread_bps         AS rate_spread_bps,\n  equity_pct              AS equity_pct,\n  recommended_offer       AS recommended_offer,\n  rank_overall            AS rank_overall\nFROM mip.gold.lead_population\nORDER BY opportunity_score DESC, rank_overall ASC\nLIMIT 10"
      ]
    }
  ],
