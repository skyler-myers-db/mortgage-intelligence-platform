              "widgetType": "bar",
              "encodings": {
                "x": { "fieldName": "segment_name", "scale": { "type": "categorical", "sort": { "by": "borrower_count", "direction": "descending" } }, "displayName": "Segment" },
                "y": { "fieldName": "borrower_count", "scale": { "type": "quantitative" }, "displayName": "Borrowers" }
              },
              "frame": {
                "title": "Segment Size",
                "description": "Borrower count per segment across current Cotality data coverage",
                "showTitle": true,
                "showDescription": true
              }
            }
          },
          "position": { "x": 0, "y": 6, "width": 3, "height": 5 }
        },
        {
          "widget": {
            "name": "chart_segment_avg_score",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_segment_avg_score",
                  "fields": [
                    { "name": "segment_name", "expression": "`segment_name`" },
                    { "name": "mean_opportunity_score", "expression": "`mean_opportunity_score`" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": { "fieldName": "segment_name", "scale": { "type": "categorical", "sort": { "by": "mean_opportunity_score", "direction": "descending" } }, "displayName": "Segment" },
                "y": { "fieldName": "mean_opportunity_score", "scale": { "type": "quantitative" }, "displayName": "Mean Opportunity Score" }
