                    { "name": "segment_code", "expression": "`segment_code`" },
                    { "name": "name", "expression": "`name`" },
                    { "name": "borrower_count", "expression": "`borrower_count`" },
                    { "name": "mean_opportunity_score", "expression": "`mean_opportunity_score`" },
                    { "name": "mean_rate_spread_bps", "expression": "`mean_rate_spread_bps`" },
                    { "name": "mean_equity_pct", "expression": "`mean_equity_pct`" },
                    { "name": "in_the_money_borrowers", "expression": "`in_the_money_borrowers`" },
                    { "name": "delta_vs_prior_label", "expression": "`delta_vs_prior_label`" },
                    { "name": "description", "expression": "`description`" }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 1,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  { "fieldName": "name", "displayName": "Segment" },
                  { "fieldName": "borrower_count", "displayName": "Borrowers" },
                  { "fieldName": "mean_opportunity_score", "displayName": "Mean Opportunity Score" },
                  { "fieldName": "mean_rate_spread_bps", "displayName": "Mean Rate Spread (bps)" },
                  { "fieldName": "mean_equity_pct", "displayName": "Mean Equity (%)" },
                  { "fieldName": "in_the_money_borrowers", "displayName": "In-the-Money Borrowers" },
                  { "fieldName": "delta_vs_prior_label", "displayName": "Quarter-over-Quarter Change" },
                  { "fieldName": "description", "displayName": "Description" }
                ]
              },
              "frame": {
                "title": "Segment Performance - National Rollup",
                "description": "Per-segment size and economics. Approval rate and outreach rate are authoritative in Lakebase and are not joined here; see Approvals dashboard in the app for those measures.",
                "showTitle": true,
                "showDescription": true
              }
            }
          },
          "position": { "x": 0, "y": 0, "width": 6, "height": 6 }
        },
        {
          "widget": {
            "name": "chart_segment_counts",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_segment_counts",
