{
  "datasets": [
    {
      "name": "ds_segment_overview",
      "displayName": "Segment overview (national rollup)",
      "queryLines": [
        "SELECT",
        "  sp.segment_code                        AS segment_code,",
        "  sp.name                                AS name,",
        "  sp.count                               AS borrower_count,",
        "  sp.avg_score                           AS mean_opportunity_score,",
        "  sp.delta_vs_prior                      AS delta_vs_prior_label,",
        "  sp.description                         AS description,",
        "  agg.mean_rate_spread_bps               AS mean_rate_spread_bps,",
        "  agg.mean_equity_pct                    AS mean_equity_pct,",
        "  agg.in_the_money_borrowers             AS in_the_money_borrowers",
        "FROM mip.semantics.segment_performance_metric_view AS sp",
        "LEFT JOIN (",
        "  SELECT",
        "    segment_code                         AS segment_code,",
        "    CAST(ROUND(AVG(rate_spread_bps)) AS INT) AS mean_rate_spread_bps,",
        "    CAST(ROUND(AVG(equity_pct))     AS INT)  AS mean_equity_pct,",
        "    SUM(CASE WHEN in_the_money THEN 1 ELSE 0 END) AS in_the_money_borrowers",
        "  FROM mip.semantics.borrower_opportunity_metric_view",
        "  LATERAL VIEW EXPLODE(segment_codes) seg AS segment_code",
        "  GROUP BY segment_code",
        ") AS agg",
        "  ON sp.segment_code = agg.segment_code",
        "WHERE sp.state = '_ALL'",
        "ORDER BY sp.count DESC"
      ]
    },
    {
      "name": "ds_segment_counts",
      "displayName": "Segment counts (national rollup)",
      "queryLines": [
        "SELECT",
        "  segment_code                     AS segment_code,",
        "  name                             AS segment_name,",
        "  count                            AS borrower_count",
        "FROM mip.semantics.segment_performance_metric_view",
        "WHERE state = '_ALL'",
        "ORDER BY count DESC"
      ]
    },
    {
      "name": "ds_segment_avg_score",
      "displayName": "Segment mean opportunity score",
      "queryLines": [
        "SELECT",
        "  segment_code                     AS segment_code,",
        "  name                             AS segment_name,",
        "  avg_score                        AS mean_opportunity_score",
        "FROM mip.semantics.segment_performance_metric_view",
        "WHERE state = '_ALL'",
        "ORDER BY avg_score DESC"
      ]
    },
    {
      "name": "ds_segment_by_state",
      "displayName": "Segment counts by state",
      "queryLines": [
        "SELECT",
        "  state                            AS state,",
        "  segment_code                     AS segment_code,",
        "  name                             AS segment_name,",
        "  count                            AS borrower_count",
        "FROM mip.semantics.segment_performance_metric_view",
        "WHERE state <> '_ALL'",
        "ORDER BY state, count DESC"
      ]
    },
    {
      "name": "ds_top_segments_per_state",
      "displayName": "Top 3 segments per state",
      "queryLines": [
        "WITH ranked AS (",
        "  SELECT",
        "    state,",
        "    segment_code,",
        "    name                              AS segment_name,",
        "    count                             AS borrower_count,",
        "    ROW_NUMBER() OVER (PARTITION BY state ORDER BY count DESC) AS state_rank",
        "  FROM mip.semantics.segment_performance_metric_view",
        "  WHERE state <> '_ALL'",
        ")",
        "SELECT state, segment_code, segment_name, borrower_count, state_rank",
        "FROM ranked",
        "WHERE state_rank <= 3",
        "ORDER BY state, state_rank"
      ]
    },
    {
      "name": "ds_evidence_daily",
      "displayName": "Evidence events per day (last 30 days)",
      "queryLines": [
        "SELECT",
        "  SUBSTRING(`timestamp`, 1, 10)    AS event_date,",
        "  signal_type                      AS signal_type,",
        "  COUNT(*)                         AS event_count",
        "FROM mip.gold.evidence_events",
        "WHERE `timestamp` >= DATE_FORMAT(CURRENT_DATE() - INTERVAL 30 DAYS, 'yyyy-MM-dd')",
        "GROUP BY SUBSTRING(`timestamp`, 1, 10), signal_type",
        "ORDER BY event_date, signal_type"
      ]
    },
    {
      "name": "ds_evidence_by_signal",
      "displayName": "Evidence events by signal type",
      "queryLines": [
        "SELECT",
        "  signal_type                      AS signal_type,",
        "  source_product                   AS source_product,",
        "  COUNT(*)                         AS event_count,",
        "  CAST(ROUND(AVG(confidence), 3) AS DOUBLE) AS mean_confidence",
        "FROM mip.gold.evidence_events",
        "GROUP BY signal_type, source_product",
        "ORDER BY event_count DESC"
      ]
    }
  ],
  "pages": [
    {
      "name": "page_segment_performance",
      "displayName": "Segment performance",
      "layout": [
        {
          "widget": {
            "name": "table_segment_overview",
            "queries": [
              {
                "name": "main_query",
                "query": {
