# Client profile template (schema v1, tools/clients/schema.py).
#
# Placeholders only: every client value is a <placeholder>. The only literals
# are the three values the schema fixes (profile version, catalog, review mode).
# A real profile never lives in the repository:
#   - CI: one GitHub Environment per client. Public fields are environment
#     variables; identifying and secret fields are environment secrets.
#   - Local: copy the fields into .env.local (gitignored).
# Check this template:  python -m tools.clients check --env-file-only \
#                         --env-file deploy/clients/example.env --allow-placeholders
# Check a real profile: python -m tools.clients check

# ---- public: GitHub Environment variables ----------------------------------
MIP_CLIENT=<client-key>
MIP_PROFILE_VERSION=1
MIP_CLOUD=<aws|azure|gcp>
MIP_IDENTITY_PREFIX=<identity-prefix>
MIP_INSTALL_CLASS=<demo|customer>
MIP_APP_ENV=<sandbox|prod>
MIP_AGENTIC_TIER=<off|on>
MIP_SCHEDULED_REFRESH=<off|on>
MIP_REVIEW_MODE=single_maintainer_audited
# Demo installs only.
MIP_ENABLE_DEMO_FIRST_PARTY_FEEDS=<0|1>
MIP_PRESENTER_MODE=<0|1>
MIP_LAKEBASE_READABLE_SECONDARIES=<true|false>
# Resource names.
MIP_DEFAULT_CATALOG=mip
MIP_LAKEBASE_SYNC_CATALOG=<lakebase-sync-catalog>
MIP_LAKEBASE_SYNC_SCHEMA=<lakebase-sync-schema>
MIP_APP_NAME=<app-name>
MIP_LAKEBASE_INSTANCE=<lakebase-instance>
LAKEBASE_DATABASE=<lakebase-database>
MIP_RUNTIME_SECRET_SCOPE=<runtime-secret-scope>
MIP_APP_ROLLBACK_SECRET_SCOPE=<app-rollback-secret-scope>
MIP_AGENT_PROXY_SECRET_SCOPE=<agent-proxy-secret-scope>
MIP_PII_SALT_SCOPE=<pii-salt-scope>
MIP_GENIE_SPACE_NAME='<genie-space-title>'
MIP_AGENT_SUPERVISOR_NAME='<supervisor-title>'
MIP_AI_GATEWAY_TABLE_PREFIX=<gateway-table-prefix>
MIP_AI_GATEWAY_AGENT_EXPERIMENT_BASE=<gateway-experiment-base>
# Optional: the Cotality source share's names (canonical names when unset).
MIP_COTALITY_SOURCE_CATALOG=<cotality-source-catalog>
MIP_COTALITY_SOURCE_SCHEMA=<cotality-source-schema>
MIP_COTALITY_SOURCE_TABLE_PREFIX=<cotality-table-prefix>
# Customer installs only: the sha256 of MIP_LENDER_IDENTITY_JSON's canonical
# JSON, the deploying maintainer's exact-digest acknowledgement. Print it with
#   MIP_LENDER_IDENTITY_JSON='...' python -m backend.schemas.lender_identity_record
MIP_LENDER_IDENTITY_SHA256=<lender-identity-sha256>

# ---- identifying: GitHub Environment secrets --------------------------------
DATABRICKS_HOST=<https-workspace-origin>
MIP_EXPECT_WORKSPACE_ID=<workspace-id>
MIP_EXPECT_METASTORE_ID=<metastore-id>
DATABRICKS_ACCOUNT_ID=<account-id>
# Optional: derived from MIP_CLOUD when unset.
DATABRICKS_ACCOUNT_HOST=<https-account-console-origin>
# Application ids by role. verifier, runtime and proxy: agentic tier only.
MIP_IDENTITY_IDS_JSON='{"deployer":"<deployer-application-id>","jobs":"<jobs-application-id>","validator":"<validator-application-id>","normal":"<normal-application-id>","operator2":"<operator2-application-id>","admin":"<admin-application-id>","release_probe":"<release-probe-application-id>","verifier":"<verifier-application-id>","runtime":"<runtime-application-id>","proxy":"<proxy-application-id>","account_principal":"<account-principal-application-id>"}'
MIP_UC_METASTORE_OWNER=<metastore-owner-principal>
MIP_UC_APPROVED_OWNER_PRINCIPALS=<data-owners-group>,<approved-owner-principal>
MIP_GENIE_MANAGER_PRINCIPALS=<genie-manager-principal>
MIP_SCHEDULED_REFRESH_RECIPIENTS=<refresh-failure-email>
MIP_ADMIN_EMAILS=<admin-email>
MIP_APPROVER_EMAILS=<approver-email>
MIP_AUDITOR_EMAILS=<auditor-email>
MIP_ADMIN_IDENTITIES=<extra-admin-identity>
MIP_APPROVER_IDENTITIES=<extra-approver-identity>
MIP_AUDITOR_IDENTITIES=<auditor-identity>
MIP_ADMIN_GROUP_NAME=<admin-group>
MIP_APPROVER_GROUP_NAME=<approver-group>
MIP_COTALITY_SHARE_PROVIDER=<cotality-share-provider>
MIP_COTALITY_SHARE_NAME=<cotality-share-name>
MIP_UC_CATALOG_STORAGE_ROOT=<catalog-storage-root>
MIP_DASHBOARD_PARENT_PATH=<dashboard-parent-folder>
# Customer installs only; pinned by MIP_LENDER_IDENTITY_SHA256. An optional
# "mark" object adds the lender's reviewed co-branding mark (docs/deployment.md).
MIP_LENDER_IDENTITY_JSON='{"version":1,"legal_name":"<lender-legal-name>","nmls_id":"<lender-nmls-id>","tenant_id":"<tenant-id>","servicer_aliases":["<servicer-alias>"],"reviewed_by":"<reviewer-email>","reviewed_at":"<review-date>"}'
# Accepted shared-estate exposure (plan section 4.12); [] when none.
MIP_ACCEPTED_EXPOSURE_JSON='[{"kind":"<uc_grant|uc_ownership|workspace_permission>","securable":{"type":"<securable-type>","id":"<securable-id>","name":"<securable-full-name>"},"grantee":"<grantee>","privileges":["<privilege>"],"source":"<direct|inherited:path>","binding":{"isolation_mode":"<OPEN|ISOLATED>","workspace_ids":["<bound-workspace-id>"]},"identities":["<app|runtime|proxy>"],"privilege_class":"<read|elevated>","reason":"<reason>","expires_at":"<expiry-date>"}]'
# Demo installs only.
MIP_SEED_OPERATOR_EMAIL=<seed-operator-email>

# ---- secret: GitHub Environment secrets --------------------------------------
DATABRICKS_CLIENT_SECRET=<normal-m2m-secret>
DATABRICKS_OPERATOR2_CLIENT_SECRET=<operator2-m2m-secret>
DATABRICKS_ADMIN_CLIENT_SECRET=<admin-m2m-secret>
DATABRICKS_RELEASE_PROBE_CLIENT_SECRET=<release-probe-m2m-secret>
DATABRICKS_ACCOUNT_CLIENT_SECRET=<account-principal-secret>
MIP_AI_GATEWAY_PROOF_SIGNING_KEY=<proof-signing-key>
# Agentic tier only.
DATABRICKS_VERIFIER_CLIENT_SECRET=<verifier-m2m-secret>
DATABRICKS_AGENT_RUNTIME_CLIENT_SECRET=<runtime-m2m-secret>
DATABRICKS_AGENT_PROXY_CREDENTIAL_BUNDLE=<proxy-credential-bundle>
MIP_GATEWAY_MODEL_ATTESTATION_SIGNING_KEY=<model-attestation-signing-key>
