{
  "name": "mip-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --reporter=list --workers=1"
