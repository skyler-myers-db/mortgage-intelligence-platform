{
  "name": "mip-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.22 <26",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node ../tools/postbuild_artifacts.mjs && node ../tools/precompress_assets.mjs",
    "budget": "node ../tools/check_frontend_budgets.mjs",
    "gen:api": "python3 ../tools/gen_api_types.py --write",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0 && node ../tools/lint_css_literals.mjs && npm run typecheck:e2e-fixture && npm run lint:a11y && npm run typecheck:e2e",
    "lint:a11y": "node ../tools/oxlint_ratchet.mjs --check oxlint-baseline.json",
    "typecheck:e2e-fixture": "tsc -p tests/e2e/fixture/tsconfig.json",
    "typecheck:e2e": "tsc -p tests/e2e/tsconfig.json",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --reporter=list --workers=1",
    "e2e:fixture": "E2E_FIXTURE=1 playwright test",
    "e2e:fixture:ci": "E2E_FIXTURE=1 CI=1 playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tanstack/react-query": "5.100.10",
    "@tanstack/react-query-persist-client": "5.100.10",
    "@tanstack/react-virtual": "3.13.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "topojson-client": "3.1.0",
    "us-atlas": "3.0.1",
    "web-vitals": "6.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "7.29.7",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "20.10.3",
    "oxlint": "1.85.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  }
}
