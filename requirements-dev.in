# Test, lint and type-check tools for CI and local development. The Databricks
# App never installs them: its requirements.txt reads only uv.lock and
# requirements.in. requirements-dev.txt installs both sets.
# requirements-dev.lock pins this file's closure. It is compiled with uv.lock
# as a constraint, so every package the two closures share keeps the App's pin:
#   uv pip compile requirements-dev.in -c uv.lock --python-version 3.11 \
#     --format requirements.txt --output-file requirements-dev.lock
# Refresh it the way uv.lock is refreshed: narrowly, with --upgrade-package.
pytest==9.0.3
pytest-cov==6.0.0
pytest-xdist==3.8.0
ruff==0.8.6
