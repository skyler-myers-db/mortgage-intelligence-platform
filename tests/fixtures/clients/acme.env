# A synthetic second client, "acme", for the portability proof (M3-PR4):
# tests/unit/test_client_portability_proof.py and the client-portability-proof
# job in .github/workflows/ci.yml.
#
# Every value is fictional: example-domain addresses, a host under an
# "-example" label, short workspace ids and all-zero-prefixed UUIDs. It is a
# customer install of another lender, with the App in prod, the agentic tier
# off, the weekly refresh off and the Cotality share mounted as
# cotality_prod.mortgage with tables carrying no prefix ("-").
#
# Deliberately absent, and created only inside the proof's sandbox clone:
#   - every secret-class field (the M2M secrets and the proof signing key);
#   - MIP_LENDER_IDENTITY_SHA256, the exact-digest pin of the lender record
#     below, and MIP_ACK_ACCEPTED_EXPOSURE_PLAN, the exact-digest ack of the
#     accepted exposure below (the owner attestation layer is deferred, M1-PR5).
# So this file alone never resolves: `python -m tools.clients check` refuses
# the unpinned record and the missing secrets.

# ---- public ------------------------------------------------------------------
MIP_CLIENT=acme
MIP_PROFILE_VERSION=1
MIP_CLOUD=aws
MIP_IDENTITY_PREFIX=acme
MIP_INSTALL_CLASS=customer
MIP_APP_ENV=prod
MIP_AGENTIC_TIER=off
MIP_SCHEDULED_REFRESH=off
MIP_REVIEW_MODE=single_maintainer_audited
MIP_LAKEBASE_READABLE_SECONDARIES=false
MIP_DEFAULT_CATALOG=mip
MIP_LAKEBASE_SYNC_CATALOG=acme_app_state
MIP_LAKEBASE_SYNC_SCHEMA=acme_sync
MIP_APP_NAME=acme-app
MIP_LAKEBASE_INSTANCE=acme-app-state
LAKEBASE_DATABASE=acme_app_state
MIP_RUNTIME_SECRET_SCOPE=acme-runtime
MIP_APP_ROLLBACK_SECRET_SCOPE=acme-app-rollback
MIP_AGENT_PROXY_SECRET_SCOPE=acme-app-agent-proxy
# The silver SQL and the pipeline read secret('mip', 'pii-salt-v1') literally,
# as they name catalog mip: both stay fixed until the catalog-label slice lands.
MIP_PII_SALT_SCOPE=mip
MIP_GENIE_SPACE_NAME='Acme Lead Intelligence'
MIP_AGENT_SUPERVISOR_NAME='Acme Growth Agent'
MIP_AI_GATEWAY_TABLE_PREFIX=acme_agent_gateway
MIP_AI_GATEWAY_AGENT_EXPERIMENT_BASE=acme-agent-gateway
MIP_COTALITY_SOURCE_CATALOG=cotality_prod
MIP_COTALITY_SOURCE_SCHEMA=mortgage
MIP_COTALITY_SOURCE_TABLE_PREFIX=-

# ---- identifying -------------------------------------------------------------
DATABRICKS_HOST=https://acme-example.cloud.databricks.com
MIP_EXPECT_WORKSPACE_ID=7317000042
MIP_EXPECT_METASTORE_ID=00000000-0000-4000-8000-0000000ac001
DATABRICKS_ACCOUNT_ID=00000000-0000-4000-8000-0000000ac002
MIP_IDENTITY_IDS_JSON='{"deployer":"00000000-0000-4000-8000-0000000ac101","jobs":"00000000-0000-4000-8000-0000000ac102","validator":"00000000-0000-4000-8000-0000000ac103","normal":"00000000-0000-4000-8000-0000000ac104","operator2":"00000000-0000-4000-8000-0000000ac105","admin":"00000000-0000-4000-8000-0000000ac106","release_probe":"00000000-0000-4000-8000-0000000ac107","account_principal":"00000000-0000-4000-8000-0000000ac111"}'
MIP_UC_METASTORE_OWNER=acme-metastore-owners
MIP_UC_APPROVED_OWNER_PRINCIPALS=acme-data-owners,owner@acme.example
MIP_GENIE_MANAGER_PRINCIPALS=acme-genie-managers
MIP_ADMIN_EMAILS=admin@acme.example
MIP_APPROVER_EMAILS=approver@acme.example
MIP_AUDITOR_EMAILS=auditor@acme.example
MIP_ADMIN_IDENTITIES=00000000-0000-4000-8000-0000000ac121
MIP_APPROVER_IDENTITIES=00000000-0000-4000-8000-0000000ac122
MIP_AUDITOR_IDENTITIES=00000000-0000-4000-8000-0000000ac123
MIP_ADMIN_GROUP_NAME=acme-admin
MIP_APPROVER_GROUP_NAME=acme-approver
MIP_COTALITY_SHARE_PROVIDER=acme_cotality_provider
MIP_COTALITY_SHARE_NAME=acme_mortgage_share
MIP_UC_CATALOG_STORAGE_ROOT=s3://acme-example-bucket/mip
MIP_DASHBOARD_PARENT_PATH=/Workspace/Shared/acme-dashboards
MIP_LENDER_IDENTITY_JSON='{"version":1,"legal_name":"Acme Example Lending","nmls_id":"7700042","tenant_id":"acme_example","servicer_aliases":["Acme Example Servicing"],"reviewed_by":"reviewer@acme.example","reviewed_at":"2026-10-30"}'
MIP_ACCEPTED_EXPOSURE_JSON='[{"kind":"workspace_permission","securable":{"type":"GENIE_SPACE","id":"acme-example-space-0001","name":"Acme Example Team Space"},"grantee":"acme-example-analysts","privileges":["CAN_VIEW"],"source":"direct","binding":{"isolation_mode":"ISOLATED","workspace_ids":["7317000042"]},"identities":["app"],"privilege_class":"read","reason":"Shared with the analysts group by its owner","expires_at":"2099-12-31"}]'
